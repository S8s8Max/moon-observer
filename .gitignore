*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity Addressables — ローカルビルドのみ除外
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]tream[Ii]ng[Aa]ssets/aa.meta
/[Aa]ssets/[Ss]tream[Ii]ng[Aa]ssets/aa/

# TextMesh Pro 生成アセット (任意、共有したい場合はコメントアウト)
# /Assets/TextMesh Pro/

